DATABASE_URL="postgresql://socialagent:socialagent@localhost:5433/socialagent"
BETTER_AUTH_SECRET="replace-with-openssl-rand-base64-32"
BETTER_AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Tim AI. Opsi A: router OpenAI-compatible (9Router, OpenRouter, LiteLLM)
LLM_BASE_URL=""
LLM_API_KEY=""
# Opsi B: Vercel AI Gateway (dipakai bila LLM_BASE_URL kosong)
AI_GATEWAY_API_KEY=""
# Nama model sesuai provider, mis. "cx/gpt-6-luna" (9Router) atau "anthropic/claude-sonnet-5-5" (Gateway)
AI_MODEL=""

# Worker publish: cron memanggil GET /api/cron/publish dengan "Authorization: Bearer $CRON_SECRET"
CRON_SECRET=""
# Set "interval" untuk menjalankan worker di dalam proses Next (dev/self-host)
PUBLISH_WORKER=""
# Origin HTTPS publik; wajib untuk Instagram (media diambil lewat URL)
PUBLIC_APP_URL=""
# Lokasi file media (default .storage)
STORAGE_DIR=""
