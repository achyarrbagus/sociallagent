DATABASE_URL=postgres://paperclip:paperclip@localhost:5432/paperclip
# Supabase: use a direct or Supavisor SESSION pooler URL (port 5432). Port 6543
# (transaction pooler) or pgbouncer=true is rejected at startup. Point
# DATABASE_MIGRATION_URL at the direct connection, and disable the project's
# Data API (see doc/DATABASE.md "Data API lockdown").
# DATABASE_MIGRATION_URL=postgres://postgres:password@db.PROJECT-REF.supabase.co:5432/postgres
PORT=3100
SERVE_UI=false
BETTER_AUTH_SECRET=paperclip-dev-secret
PAPERCLIP_TOOL_ACTION_SIGNING_SECRET=paperclip-dev-tool-action-signing-secret-change-me
PAPERCLIP_SENTRY_RUN_FAILURES=off

# Multi-tenant SaaS mode: forces all agent runs onto the managed sandbox and
# fails closed (never runs on the host) when no managed sandbox is active.
# SOCIALAGENT_SAAS_MODE=true
# Required with SaaS mode: the server origin sandboxes can reach. Managed
# 9Router runs call <url>/api/managed-gateway/v1 with a run-scoped token so the
# 9Router key never enters a sandbox.
# SOCIALAGENT_PUBLIC_URL=https://socialagent.example.com

# Supabase Storage via the S3 provider (see docs/deploy/storage.md). Private
# bucket; the server is the only client. Set both keys or neither.
# PAPERCLIP_STORAGE_PROVIDER=s3
# PAPERCLIP_STORAGE_S3_ENDPOINT=https://PROJECT-REF.supabase.co/storage/v1/s3
# PAPERCLIP_STORAGE_S3_REGION=ap-southeast-1
# PAPERCLIP_STORAGE_S3_BUCKET=socialagent
# PAPERCLIP_STORAGE_S3_FORCE_PATH_STYLE=true
# PAPERCLIP_STORAGE_S3_ACCESS_KEY_ID=
# PAPERCLIP_STORAGE_S3_SECRET_ACCESS_KEY=

# Optional Paperclip ID Gmail OAuth broker. Enroll the instance first; keep both
# private keys in the deployment secret manager. HTTP base URLs must be loopback.
# PAPERCLIP_ID_CONNECTOR_BASE_URL=http://localhost:3000
# PAPERCLIP_ID_CONNECTOR_ENVIRONMENT=development
# PAPERCLIP_ID_CONNECTOR_INSTANCE_ID=inst_example
# PAPERCLIP_ID_CONNECTOR_SIGN_PRIVATE_KEY=
# PAPERCLIP_ID_CONNECTOR_SEAL_PRIVATE_KEY=

# Process-wide protection for expensive full-tree workspace Git scans.
# PAPERCLIP_WORKSPACE_GIT_SCAN_CONCURRENCY=2
# PAPERCLIP_WORKSPACE_GIT_SCAN_QUEUE_CAPACITY=32
# PAPERCLIP_WORKSPACE_GIT_SCAN_TIMEOUT_MS=8000
# PAPERCLIP_WORKSPACE_GIT_SCAN_CACHE_TTL_MS=10000

# HTTP adapters may call public HTTP(S) origins by default. Opt trusted private
# origins in explicitly; entries are exact origins (scheme, host, and port).
# PAPERCLIP_HTTP_ADAPTER_PRIVATE_ENDPOINT_ALLOWLIST=http://hooks.internal.example:8080

# SocialAgent managed 9Router gateway. When the key is set, onboarding connects
# every new company to this gateway as a shared AI connection, so owners never
# enter a model credential. Leave unset to keep the manual "Connect a model" step.
# SOCIALAGENT_9ROUTER_API_KEY=
# SOCIALAGENT_9ROUTER_BASE_URL=https://9router.amifish.com/v1
# SOCIALAGENT_9ROUTER_ADAPTER=claude_local   # or codex_local
# SOCIALAGENT_9ROUTER_CLAUDE_MODEL=
# SOCIALAGENT_9ROUTER_CODEX_MODEL=
# Companies a signed-up user may create themselves in SaaS mode (default 1).
# SOCIALAGENT_MAX_COMPANIES_PER_USER=1
# Account email (password reset, email verification) over any SMTP provider.
# Without it, development logs the links; production sends nothing.
# SOCIALAGENT_SMTP_URL=smtps://user:password@smtp.example.com:465
# SOCIALAGENT_MAIL_FROM=SocialAgent <no-reply@example.com>
# Require a confirmed email before sign-in (only applies when SMTP is set).
# SOCIALAGENT_REQUIRE_EMAIL_VERIFICATION=true

# Discord webhook for daily merge digest (scripts/discord-daily-digest.sh)
# DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...
